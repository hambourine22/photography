{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/perceptual-patterns/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://hux.works https://www.hux.works https://*.webflow.io"
        }
      ]
    },
    {
      "source": "/taurus-embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://hux.works https://www.hux.works https://*.webflow.io"
        }
      ]
    }
  ]
}